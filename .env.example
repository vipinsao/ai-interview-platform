# Copy this file to .env.local. It works as it stands:
#
#     cp .env.example .env.local && npm run dev
#
# renders the entire UI immediately — landing page, sign-in screen, dashboard
# shell — on the two placeholder Supabase values below. Nothing calls out to a
# real service until you try to create an interview, and the dev server prints
# a list of whatever is still missing when it starts.
#
# Fill in real values when you want the app to actually do something.
#
# The server checks these when it starts (instrumentation.js -> lib/server/config.js)
# and refuses to boot with a list of whatever is missing, rather than serving a
# site that fails on the first request. `next build` is exempt: compiling the
# bundle makes no network calls and should not need anybody's secrets.
#
# Variables marked OPTIONAL have a documented default or turn a feature off.
# Every service listed below has a free tier that needs no credit card.

# --- Supabase (https://supabase.com — free tier, no card) --------------------

# REQUIRED. Project URL. Supabase dashboard -> Project Settings -> API -> Project URL.
# The placeholder is enough to render every page. It is syntactically valid and
# points at nothing, so the browser client starts instead of throwing — which is
# what used to turn a missing value into a 500 on the marketing page.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co

# REQUIRED. Public "anon" key. Same page, under Project API keys.
# Safe to ship to the browser: it only grants what the privileges and row level
# security policies in supabase/schema.sql allow. Notably it cannot write the
# credits column, and cannot read any table anonymously.
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# REQUIRED. Secret "service_role" key. Same page, under Project API keys.
# SERVER ONLY. It bypasses row level security, so it must never be given a
# NEXT_PUBLIC_ prefix. Used by the API routes to read a single interview for an
# anonymous candidate, to store completed interviews, to serve a shared report
# link, to keep the rate limit counters, and to grant credits after a verified
# PayPal payment — none of which a browser is allowed to do for itself.
SUPABASE_SERVICE_ROLE_KEY=

# --- Language model (https://console.groq.com/keys — free tier, no card) -----

# REQUIRED. API key used to generate questions and score answers. Server only.
# Groq's developer tier is free and rate limited rather than billed; current
# limits are at https://console.groq.com/docs/rate-limits
LLM_API_KEY=

# OPTIONAL. Model id. Defaults to openai/gpt-oss-120b, which is on Groq's
# current production list. The previous default, llama-3.3-70b-versatile, was
# retired by Groq on 2026-08-16 and now 404s.
# Must be a model that supports JSON mode on your provider.
LLM_MODEL=

# OPTIONAL. OpenAI-compatible base URL, defaults to https://api.groq.com/openai/v1
# Set this to point at a different OpenAI-compatible provider.
LLM_BASE_URL=

# --- Application ------------------------------------------------------------

# REQUIRED. Origin used to build the shareable interview links shown after
# creating an interview. http://localhost:3000 locally; your deployed origin in
# production.
NEXT_PUBLIC_HOST_URL=http://localhost:3000

# --- Billing (https://developer.paypal.com — sandbox is free, no card) -------
#
# OPTIONAL as a group: leave all three blank and the app runs with billing off —
# the purchase buttons render disabled and say so. Setting only some of them is
# refused at startup, because a client id with no secret gives the user a PayPal
# window and then a server that cannot verify what they paid.

# Client id of your PayPal app. Shipped to the browser, which is what it is for.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Secret of the SAME PayPal app. Server only — this is what lets the server ask
# PayPal what an order really was, instead of believing the browser.
PAYPAL_CLIENT_SECRET=

# OPTIONAL. "live" is the only value that selects PayPal's live API; anything
# else, including unset, uses the sandbox. Deliberately strict so a typo cannot
# quietly start taking real money.
PAYPAL_ENV=sandbox

# --- Tests ------------------------------------------------------------------

# OPTIONAL. Connection string for a THROWAWAY Postgres, used by tests/sql.test.js
# to run supabase/schema.sql and check the privileges, the atomic rate limiter
# and the idempotent credit grant. Unset, that suite is skipped.
# WARNING: the suite drops and recreates the public schema. Never point this at
# your Supabase project. See supabase/README.md.
TEST_DATABASE_URL=
