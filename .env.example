# Copy this file to .env.local and fill in the values. Nothing here has a
# default; the app fails at startup with the name of anything missing.
# Every service listed below has a free tier that needs no credit card.

# --- Supabase (https://supabase.com — free tier, no card) --------------------

# Project URL. Supabase dashboard -> Project Settings -> API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key. Same page, under Project API keys.
# Safe to ship to the browser: it only grants what the row level security
# policies in supabase/schema.sql allow.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret "service_role" key. Same page, under Project API keys.
# SERVER ONLY. It bypasses row level security, so it must never be given a
# NEXT_PUBLIC_ prefix. Used by the API routes to read a single interview for an
# anonymous candidate, to store completed interviews, and to keep the rate
# limit counters (which a user must not be able to reset for themselves).
SUPABASE_SERVICE_ROLE_KEY=

# --- Language model (https://console.groq.com/keys — free tier, no card) -----

# API key used to generate questions and score answers. Server only.
# Groq's developer tier is free and rate limited rather than billed; current
# limits are at https://console.groq.com/docs/rate-limits
LLM_API_KEY=

# Optional. Model id, defaults to llama-3.3-70b-versatile.
# Must be a model that supports JSON mode on your provider.
LLM_MODEL=

# Optional. OpenAI-compatible base URL, defaults to https://api.groq.com/openai/v1
# Set this to point at a different OpenAI-compatible provider.
LLM_BASE_URL=

# --- Application ------------------------------------------------------------

# Origin used to build the shareable interview links shown after creating an
# interview. http://localhost:3000 locally; your deployed origin in production.
NEXT_PUBLIC_HOST_URL=http://localhost:3000

# PayPal client id for the credit purchase buttons on /billing.
# Create a sandbox app at https://developer.paypal.com/dashboard/applications
# (free). Leave blank to run without the billing page working.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
